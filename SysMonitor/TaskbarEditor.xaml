<Window x:Class="SysMonitor.TaskbarEditor"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义任务栏数据"
        Icon="Assets/app.ico"
        Width="760" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="预览" FontWeight="SemiBold" Margin="0,0,0,8" />

        <!-- 模拟任务栏底色，深浅跟随“Windows 模式”（与任务栏一致）；内容由任务栏同一套绘制代码画出，太宽时缩小显示 -->
        <Border x:Name="PreviewHost" CornerRadius="6" Height="56" Padding="12,0" BorderThickness="1" BorderBrush="#30808080">
            <Grid>
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                    <Image x:Name="PreviewImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" />
                </Viewbox>
                <TextBlock x:Name="PreviewEmpty" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>
        <TextBlock x:Name="HintText" Opacity="0.6" Margin="0,6,0,0" TextWrapping="Wrap" />

        <DockPanel Margin="0,18,0,8">
            <TextBlock Text="布局" FontWeight="SemiBold" />
            <TextBlock Opacity="0.6" Margin="12,0,0,0" VerticalAlignment="Bottom" TextWrapping="Wrap"
                       Text="拖动项目可左右、上下调整位置（每列最多两行）；拖到“未显示”即隐藏。点击项目可设置显示内容。" />
        </DockPanel>

        <!-- 拖动时鼠标捕获在 LayoutArea 上：项目卡片会随布局变化重建，捕获在它们身上会丢 -->
        <Grid x:Name="LayoutArea" Background="Transparent"
              MouseMove="LayoutArea_MouseMove" MouseLeftButtonUp="LayoutArea_MouseLeftButtonUp"
              LostMouseCapture="LayoutArea_LostMouseCapture">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="ColumnsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ColumnsPanel" Orientation="Horizontal" Margin="0,0,0,4" />
            </ScrollViewer>
            <DockPanel Grid.Row="1" Margin="0,6,0,0">
                <TextBlock Text="未显示" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Border x:Name="PoolArea" CornerRadius="6" BorderThickness="1" BorderBrush="#30808080"
                        Background="#08808080" Padding="6,6,0,0" MinHeight="48">
                    <WrapPanel x:Name="PoolPanel" />
                </Border>
            </DockPanel>
            <!-- 拖动中跟着鼠标走的卡片影子 -->
            <Canvas x:Name="DragLayer" Grid.RowSpan="2" IsHitTestVisible="False" />
        </Grid>

        <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="6" BorderThickness="1" BorderBrush="#30808080">
            <StackPanel>
                <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" Margin="0,0,0,6" />
                <WrapPanel x:Name="DetailPanel" />
                <TextBlock x:Name="DetailNote" Opacity="0.6" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <CheckBox x:Name="MetersBox" Content="占用率前显示小条" Margin="0,12,0,0"
                  Checked="Meters_Changed" Unchecked="Meters_Changed" />

        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="恢复默认" MinWidth="88" Click="Reset_Click" />
            <Button DockPanel.Dock="Right" Content="取消" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="确定" MinWidth="88" IsDefault="True" Click="Ok_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
        </DockPanel>
    </StackPanel>
</Window>
