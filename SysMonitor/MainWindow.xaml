<Window x:Class="SysMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SysMonitor"
        x:Name="Root"
        Title="SysMonitor 系统监控"
        Icon="Assets/app.ico"
        Width="1240" Height="800" MinWidth="860" MinHeight="520"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <!-- 紧凑一点的表格行 -->
        <Style x:Key="RowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <!-- 传感器行：极简模板（一个 Border + 内容），悬停/选中用半透明色，深浅主题通用。
             高度 / 透明度 / 可见性绑定到所属分组的折叠进度，实现平滑折叠 -->
        <Style x:Key="SensorRowStyle" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="{Binding RowHeight}" />
            <Setter Property="Opacity" Value="{Binding RowOpacity}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- 内容贴顶，折叠时从下往上被裁掉，文字不会上下乱跳 -->
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="12,5,12,0" Margin="1,0">
                            <ContentPresenter VerticalAlignment="Top" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14808080" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#400078D4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分组标题：只是个容器，外观在 SensorGroup 的数据模板里 -->
        <Style x:Key="SensorHeaderStyle" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,6,0,2" />
            <Setter Property="Visibility" Value="{Binding HeaderVisibility}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- 标题栏铺满整行，箭头在最右边 -->
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <local:SensorItemStyleSelector x:Key="SensorItemStyleSelector"
                                       HeaderStyle="{StaticResource SensorHeaderStyle}"
                                       RowStyle="{StaticResource SensorRowStyle}" />
    </Window.Resources>

    <DockPanel>
        <!-- 菜单 -->
        <Menu DockPanel.Dock="Top" Padding="4,2">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="导出报告(_E)…" InputGestureText="Ctrl+S" Click="Export_Click" />
                <Separator />
                <MenuItem Header="退出(_X)" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="查看(_V)">
                <MenuItem Header="刷新硬件信息(_R)" InputGestureText="F5" Click="RefreshInfo_Click" />
                <MenuItem x:Name="IntervalMenu" Header="传感器刷新间隔">
                    <MenuItem Header="0.5 秒" Tag="500" Click="Interval_Click" />
                    <MenuItem Header="1 秒" Tag="1000" Click="Interval_Click" />
                    <MenuItem Header="2 秒" Tag="2000" Click="Interval_Click" />
                    <MenuItem Header="5 秒" Tag="5000" Click="Interval_Click" />
                </MenuItem>
                <MenuItem x:Name="ThemeMenu" Header="主题">
                    <MenuItem Header="跟随系统" Tag="System" Click="Theme_Click" />
                    <MenuItem Header="浅色" Tag="Light" Click="Theme_Click" />
                    <MenuItem Header="深色" Tag="Dark" Click="Theme_Click" />
                </MenuItem>
                <MenuItem Header="重置最小/最大值" Click="ResetMinMax_Click" />
                <Separator />
                <MenuItem x:Name="TrayItem" Header="最小化到托盘" IsCheckable="True" Click="Tray_Click" />
                <MenuItem x:Name="TaskbarMenu" Header="任务栏数据">
                    <MenuItem Header="不显示" Tag="Off" Click="Taskbar_Click" />
                    <MenuItem Header="显示在左侧" Tag="Left" Click="Taskbar_Click" />
                    <MenuItem Header="显示在右侧" Tag="Right" Click="Taskbar_Click" />
                </MenuItem>
                <MenuItem x:Name="TopmostItem" Header="窗口置顶" IsCheckable="True" Click="Topmost_Click" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于(_A)" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Padding="14,6" BorderThickness="0,1,0,0" BorderBrush="#30808080">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="DriverText" Opacity="0.7" Margin="0,0,24,0" />
                <TextBlock x:Name="StatsText" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧分类 -->
            <TreeView x:Name="Nav" Margin="6,8,0,8" SelectedItemChanged="Nav_SelectedItemChanged">
                <TreeViewItem Header="计算机" Tag="系统摘要" IsExpanded="True">
                    <TreeViewItem Header="系统摘要" Tag="系统摘要" />
                    <TreeViewItem Header="传感器" Tag="sensors" />
                    <TreeViewItem Header="实时曲线" Tag="graphs" />
                </TreeViewItem>
                <TreeViewItem Header="操作系统" Tag="操作系统" />
                <TreeViewItem Header="处理器" Tag="处理器" />
                <TreeViewItem Header="主板" Tag="主板" />
                <TreeViewItem Header="内存" Tag="内存" />
                <TreeViewItem Header="显示设备" Tag="显示设备" />
                <TreeViewItem Header="存储" Tag="存储" />
                <TreeViewItem Header="网络" Tag="网络" />
            </TreeView>

            <DockPanel Grid.Column="1" Margin="12,8,14,8">
                <!-- 驱动 / 权限提示 -->
                <Border x:Name="Banner" DockPanel.Dock="Top" Visibility="Collapsed" CornerRadius="4"
                        Padding="12,8" Margin="0,0,0,8" Background="#33FFB900">
                    <TextBlock x:Name="BannerText" TextWrapping="Wrap" />
                </Border>

                <Grid>
                    <TextBlock x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />

                    <!-- 硬件信息页 -->
                    <ListView x:Name="InfoList" Visibility="Collapsed" SelectionMode="Extended"
                              ItemContainerStyle="{StaticResource RowStyle}"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              SizeChanged="InfoList_SizeChanged">
                        <ListView.CommandBindings>
                            <CommandBinding Command="ApplicationCommands.Copy" Executed="ListCopy_Executed" />
                        </ListView.CommandBindings>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制" Command="ApplicationCommands.Copy" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   Margin="4,14,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="InfoNameColumn" Header="项目" Width="240" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn x:Name="InfoValueColumn" Header="值" Width="700">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- 传感器 -->
                    <DockPanel x:Name="SensorView" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="FilterBox" Width="300" TextChanged="Filter_TextChanged"
                                     ToolTip="按名称 / 类型 / 硬件过滤，中英文都可以" />
                            <CheckBox x:Name="ShowEmptyBox" Content="显示无数据项" Margin="16,0,0,0"
                                      Checked="ShowEmpty_Changed" Unchecked="ShowEmpty_Changed" />
                            <TextBlock Text="双击或右键传感器可加入/移出曲线" Opacity="0.6"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>

                        <!-- 表头（列宽与下面行模板一致；固定列在左、弹性列在右，滚动条出现与否都对得齐） -->
                        <Grid DockPanel.Dock="Top" Margin="14,0,0,6" Opacity="0.7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="传感器" />
                            <TextBlock Grid.Column="1" Text="类型" />
                            <TextBlock Grid.Column="2" Text="当前" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="最小" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="最大" TextAlignment="Right" />
                        </Grid>

                        <!-- 扁平列表：分组标题（SensorGroup）和传感器行（SensorRow）都是列表项。
                             原则是“动画过程中绝不新建行”（WPF 建一行约 1ms，建几十行就会掉帧）：
                             - 所有行在数据到达时分批建好（每帧 30 行，见 PopulateSensorItems），之后不再重建；
                             - 折叠 / 不匹配搜索只把行高设为 0，展开只是行高动画（SensorGroup 驱动，见 Models.cs）。
                             因此不虚拟化，并用普通 StackPanel（VirtualizingStackPanel 关虚拟化后布局开销随行数平方增长） -->
                        <ListBox x:Name="SensorList" SelectionMode="Extended"
                                 ItemContainerStyleSelector="{StaticResource SensorItemStyleSelector}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="SensorList_MouseDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.CommandBindings>
                                <CommandBinding Command="ApplicationCommands.Copy" Executed="ListCopy_Executed" />
                            </ListBox.CommandBindings>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="加入 / 移出实时曲线" Click="ToggleGraph_Click" />
                                    <MenuItem Header="复制" Command="ApplicationCommands.Copy" />
                                    <Separator />
                                    <MenuItem Header="重置最小/最大值" Click="ResetMinMax_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.Resources>
                                <!-- 分组标题：配色沿用 Fluent Expander 的资源；箭头角度绑定折叠进度，与行高动画同步 -->
                                <DataTemplate DataType="{x:Type local:SensorGroup}">
                                    <!-- Fluent 的 ToggleButton 默认靠左对齐，要显式拉伸才能铺满整行 -->
                                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                  Foreground="{DynamicResource ExpanderHeaderForeground}"
                                                  Background="{DynamicResource ExpanderHeaderBackground}"
                                                  BorderBrush="{DynamicResource ExpanderHeaderBorderBrush}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1" CornerRadius="4">
                                                    <Grid>
                                                        <Border x:Name="Hover" Background="#14808080" CornerRadius="4" Visibility="Collapsed" />
                                                        <Grid Margin="12,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="&#xE70D;" FontSize="12"
                                                                       FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                                       VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                                <TextBlock.RenderTransform>
                                                                    <RotateTransform Angle="{Binding ChevronAngle}" />
                                                                </TextBlock.RenderTransform>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text="{Binding Count, Mode=OneWay, StringFormat=（{0}）}" />
                                        </TextBlock>
                                    </ToggleButton>
                                </DataTemplate>

                                <!-- 传感器行（列宽与上方表头一致） -->
                                <DataTemplate DataType="{x:Type local:SensorRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="360" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="NameText" Text="{Binding Name}" ToolTip="{Binding OriginalName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding TypeName}" Opacity="0.6" />
                                        <TextBlock x:Name="ValueText" Grid.Column="2" Text="{Binding Value}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding Min}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{Binding Max}" TextAlignment="Right" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding InGraph}" Value="True">
                                            <Setter TargetName="NameText" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="1">
                                            <Setter TargetName="ValueText" Property="Foreground" Value="#F7A23B" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="2">
                                            <Setter TargetName="ValueText" Property="Foreground" Value="#F0524F" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.Resources>
                        </ListBox>
                    </DockPanel>

                    <!-- 实时曲线 -->
                    <DockPanel x:Name="GraphView" Visibility="Collapsed" SizeChanged="GraphView_SizeChanged">
                        <TextBlock DockPanel.Dock="Top" Opacity="0.6" Margin="6,0,0,6"
                                   Text="提示：在“传感器”页双击或右键任意传感器即可加入曲线；右键曲线可移除。" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="GraphList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding GraphColumns, ElementName=Root}" VerticalAlignment="Top" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:GraphCard Model="{Binding}" Height="230" Margin="6">
                                            <local:GraphCard.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="移除此曲线" Click="RemoveGraph_Click" />
                                                </ContextMenu>
                                            </local:GraphCard.ContextMenu>
                                        </local:GraphCard>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
